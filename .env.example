# Copy this file to `.env.local` and fill your real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gold / Silver Pricing API
GOLD_API_KEY=your-gold-api-key
GOLD_API_BASE_URL=https://www.goldapi.io/api

# App URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Auth
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Razorpay
# Local dev uses sandbox keys. Production uses live keys.
NEXT_PUBLIC_RAZORPAY_SANDBOX_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_SANDBOX_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_SANDBOX_KEY_SECRET=your-razorpay-sandbox-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-live-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cloudinary / Media
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
